  "implementationGuidance": [
    {
      "rule": "separate_surface_roles",
      "text": "为玻璃、实墙、金属/涂层框、屋顶使用独立角色；重点地标不共用一个黑色玻璃实例。",
      "status": "art_direction"
    },
    {
      "rule": "dielectric_glass",
      "text": "玻璃/石材/瓷砖/涂漆表层使用 metallic=0；只有明确或标为艺术推定的裸金属角色使用1。玻璃反射由介电反射与环境光实现，不能靠把全楼变成金属。",
      "sourceIds": [
        "filament-pbr"
      ],
      "status": "primary_PBR_model_with_artistic_proxies"
    },
    {
      "rule": "daylight_before_night",
      "text": "先在中性日光和一致曝光检查浅墙/玻璃层次，再检查黄昏；夜景只对窗与灯发光，不用整墙发光掩盖缺少环境照明。",
      "status": "art_direction"
    },
    {
      "rule": "avoid_double_darkening",
      "text": "不要把带重阴影的颜色贴图再次乘上深灰全楼底色；核对色彩空间和环境光后再调色。",
      "status": "implementation_review_advice"
    },
    {
      "rule": "coherent_variation",
      "text": "按用途/已有照片/片区为楼选择材质族，每楼固定；同族色相约±4度、明度约±5%的变化作为艺术上限参考，避免像素噪声与随机彩虹。",
      "status": "artistic_estimate"
    },
    {
      "rule": "lod_texture",
      "text": "远景保留墙窗面积和大分格；细缝用mipmap或法线，避免细白线远景闪烁。窗亮度按房间/连续楼层形成稀疏组团。",
      "status": "art_direction"
    },
    {
      "rule": "references_not_textures",
      "text": "公开照片作为参考链接保留；本文件没有下载或授权照片用作游戏贴图。",
      "status": "asset_provenance"
    }
  ],
